# Local configuration. Copy to .env (which is gitignored) and adjust.
# On Cloudflare these are Worker secrets and variables: `wrangler secret put NAME`.

# Required. Signs sessions and encrypts stored source credentials.
# For anything but localhost: openssl rand -hex 32
AUTH_SECRET=dev-secret-change-me

# Sign in with Google. Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and register the redirect URI
#   <your origin>/api/auth/callback/google
# For local development that is http://localhost:7732/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Lets you sign in as a single built-in admin with this password,
# without Google. The value "admin" is only accepted on localhost.
ADMIN_PASSWORD=admin

# Optional. Who may sign in with Google: comma-separated emails and domains.
# Empty means anyone with a Google account. People who were invited into a
# workspace can always sign in.
# ALLOWED_EMAILS=you@example.com, example.org

# Optional. Email, through Cloudflare Email Sending: invitations, and notices
# when a source adds, changes or removes operations. Without all three,
# nothing is sent; an invitation is then a link to pass on yourself.
# The token is a Cloudflare API token that may send email, the account is the
# one whose Email Service has the sender's domain set up.
# https://developers.cloudflare.com/email-service/
# CLOUDFLARE_EMAIL_TOKEN=
# CLOUDFLARE_EMAIL_ACCOUNT_ID=
# EMAIL_FROM=openapi-proxy <notify@mail.example.com>

# Optional. Where this instance lives. Emails sent by the hourly check use it
# for their links.
# APP_URL=https://proxy.example.com

# Optional, for running a public service rather than your own instance.
# CONTACT_EMAIL is the address requests for Pro are sent to. Setting it is what
# makes an instance sell plans: workspaces are on Free (src/shared/plans.ts)
# until they have a subscription. Leave it unset for an instance of your own,
# where every workspace has everything. PUBLIC_SITE=true serves the landing
# page and the blog at / (`pnpm dev` turns it on by itself).
# CONTACT_EMAIL=hello@example.com
# PUBLIC_SITE=true
