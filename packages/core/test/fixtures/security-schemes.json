{
  "openapi": "3.1.0",
  "info": { "title": "Security", "version": "1.0.0" },
  "security": [{ "globalAuth": [] }],
  "paths": {
    "/public": {
      "get": {
        "tags": ["public"],
        "security": [],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/admin": {
      "get": {
        "tags": ["admin"],
        "security": [{ "adminAuth": ["admin:read"] }],
        "responses": { "200": { "description": "OK" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "globalAuth": { "type": "http", "scheme": "bearer" },
      "adminAuth": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://auth.example.com/token",
            "scopes": { "admin:read": "Read admin data" }
          }
        }
      },
      "legacyAuth": { "type": "apiKey", "in": "header", "name": "X-Legacy" }
    }
  }
}
