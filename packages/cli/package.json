{
  "name": "@pipe0/openapi-proxy",
  "version": "0.1.0",
  "description": "Filter, merge and serve OpenAPI documents from a config file in your repo: a local dev server for your variants, and deploy from CI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openapi-proxy": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://openapi-proxy.app/docs",
  "bugs": "https://github.com/pipe-0/openapi-proxy/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/pipe-0/openapi-proxy",
    "directory": "packages/cli"
  },
  "keywords": [
    "openapi",
    "swagger",
    "openapi-filter",
    "openapi-merge",
    "api-docs",
    "sdk",
    "cli",
    "dev-server",
    "config-as-code"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.page.config.ts",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.page.json"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^1.19.0",
    "@openapi-proxy/core": "workspace:*",
    "@openapi-proxy/editor": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "hono": "^4.13.19",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
