{
  "openapi": "3.1.0",
  "info": {
    "title": "Bookshop API",
    "version": "1.4.0",
    "description": "Everything the bookshop's backend does."
  },
  "servers": [
    { "url": "https://api.bookshop.example", "description": "Production" },
    { "url": "http://localhost:8080", "description": "A developer's machine" }
  ],
  "tags": [
    { "name": "Books", "description": "The catalogue." },
    { "name": "Orders", "description": "What customers bought." },
    { "name": "Admin", "description": "For the bookshop's own staff." }
  ],
  "paths": {
    "/books": {
      "get": {
        "tags": ["Books"],
        "summary": "List books",
        "parameters": [{ "$ref": "#/components/parameters/Limit" }],
        "responses": {
          "200": {
            "description": "A page of books.",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Book" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Books"],
        "summary": "Add a book",
        "security": [{ "staff": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Book" } } }
        },
        "responses": {
          "201": {
            "description": "The book as stored.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Book" } } }
          },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "tags": ["Books"],
        "summary": "Get one book",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The book.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Book" } } }
          },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "List your orders",
        "security": [{ "customer": [] }],
        "responses": {
          "200": {
            "description": "Your orders, newest first.",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Orders"],
        "summary": "Place an order",
        "security": [{ "customer": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } }
        },
        "responses": {
          "201": {
            "description": "The order as placed.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Order" } }
            }
          },
          "default": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/orders/export": {
      "get": {
        "tags": ["Orders", "Admin"],
        "summary": "Export every order as CSV",
        "security": [{ "staff": [] }],
        "responses": { "200": { "description": "A CSV file.", "content": { "text/csv": {} } } }
      }
    },
    "/admin/cache": {
      "delete": {
        "tags": ["Admin"],
        "summary": "Empty the catalogue cache",
        "security": [{ "staff": [] }],
        "responses": { "204": { "description": "Emptied." } }
      }
    },
    "/admin/staff": {
      "get": {
        "tags": ["Admin"],
        "summary": "List staff accounts",
        "security": [{ "staff": [] }],
        "responses": {
          "200": {
            "description": "Everyone who can sign in to the back office.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/StaffMember" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      }
    },
    "responses": {
      "Problem": {
        "description": "What went wrong.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    },
    "schemas": {
      "Book": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "author": { "type": ["string", "null"] },
          "price": { "$ref": "#/components/schemas/Money" }
        }
      },
      "Order": {
        "type": "object",
        "required": ["books"],
        "properties": {
          "id": { "type": "string" },
          "books": { "type": "array", "items": { "$ref": "#/components/schemas/Book" } },
          "total": { "$ref": "#/components/schemas/Money" }
        }
      },
      "Money": {
        "type": "object",
        "required": ["amount", "currency"],
        "properties": {
          "amount": { "type": "integer", "description": "In the currency's smallest unit." },
          "currency": { "type": "string", "examples": ["EUR"] }
        }
      },
      "Problem": {
        "type": "object",
        "required": ["code", "message"],
        "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
      },
      "StaffMember": {
        "type": "object",
        "required": ["email"],
        "properties": { "email": { "type": "string" }, "role": { "enum": ["owner", "clerk"] } }
      }
    },
    "securitySchemes": {
      "customer": { "type": "http", "scheme": "bearer" },
      "staff": { "type": "apiKey", "in": "header", "name": "X-Staff-Key" }
    }
  }
}
