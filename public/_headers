# Response headers for static files (Workers Static Assets). Pages are rendered
# by the Worker and get theirs, including a nonce-based Content-Security-Policy,
# from src/web/routes/__root.tsx. The Worker also sets its own for /api/* and /v/*.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  # A file opened directly (an SVG, say) may load nothing and run nothing inline.
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Fingerprinted by the build, so they can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
